.DS_Store
node_modules/
*.log
# backups the pages download before destructive actions
*.backup-*.json
# Nothing in data/ is tracked: it is the user's own content. Sample content
# comes from core/templates.js (pages seed it on first open; `node solo.js
# template all` writes the files). Only the schema ships.
data/*
!data/SCHEMA.md
# your own Guide prompts exported as slash commands (built-ins are committed, yours are not)
.claude/commands/mine/
.cursor/commands/mine/

# launch material stays local: the film (source, renders, node_modules) and the
# 57 launch screenshots never enter the repo. README images live in docs/screenshots/.
docs/launch/video/
docs/screenshots/launch/
